# Redis HTTP adapter (история диалогов, адреса, тарифы; один URL для local и prod)
REDIS_ADAPTER_URL=https://adapter.freedom1.ru

# LLM API keys
MISTRAL_API_KEY=your_mistral_api_key
OPENAI_API_KEY=your_openai_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key

# Прокси (опционально)
PROXY=

# Agent Service
AGENT_SERVICE_NAME=agent-service
AGENT_MODEL=mistral-large-latest
AGENT_MAX_TOOL_ITERATIONS=4
AGENT_HISTORY_TTL_SECONDS=3600
AGENT_HISTORY_WINDOW_SIZE=20
MCP_TARIFF_URL=http://localhost:8101
MCP_SWITCHER_URL=http://localhost:8102
MCP_MILVUS_URL=http://localhost:8103

# Tariff MCP
LLM_URL=http://localhost:8002

# Milvus / nlp-utils (поиск + загрузка wiki)
MILVUS_SEARCH_URL=http://localhost:8000/v2/mlv_search
# Опционально; если пусто — выводится из MILVUS_SEARCH_URL → /v1/upload_wiki_data
MILVUS_UPLOAD_URL=

# Switcher MCP
ZABBIX_URL=http://localhost/zabbix
ZABBIX_USER=Admin
ZABBIX_PASSWORD=zabbix
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=default
SNMP_COMMUNITY=public

# Промты (можно переопределить через ConfigMap)
PROMPT_VOICE=
PROMPT_CSV=
PROMPT_TEXT=

LOG_LEVEL=INFO

# PostgreSQL (auth, admins, логи chat)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=frida

# 1С для auth
AUTH_1C_URL=http://server1c.freedom1.ru/UNF_CRM_WS/hs/Grafana/anydata
